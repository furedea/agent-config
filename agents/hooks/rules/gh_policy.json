{
  "version": 1,
  "grants": [
    {
      "target": "any",
      "effects": [
        "read",
        "local"
      ],
      "decision": "allow",
      "justification": "Reading GitHub and changing only the local checkout stay inside the grant whatever the repository."
    },
    {
      "target": "trusted",
      "effects": [
        "reversible"
      ],
      "decision": "allow",
      "justification": "A reversible write to a repository whose owner trusted_owners.json lists stays inside the grant (class B)."
    },
    {
      "target": "node",
      "operations": [
        "review_thread.resolve",
        "review_thread.unresolve"
      ],
      "decision": "allow",
      "justification": "A review thread named by node ID cannot be traced to its repository before the call; resolving and unresolving are reversible, and GitHub lets only an account with write access to that repository do either, whatever token gh holds."
    }
  ],
  "commands": {
    "issue list": {
      "operation": "issue.list",
      "effect": "read"
    },
    "issue status": {
      "operation": "issue.status",
      "effect": "read"
