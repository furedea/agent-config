{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {
    "indentWidth": 2
  },
  "toml": {},
  "markdown": {
    "listIndentKind": "pythonMarkdown",
    "textWrap": "maintain"
  },
  "includes": [
    "**/*.{json,toml,md}"
  ],
  "excludes": [
    "**/node_modules",
    "**/.git",
    "**/target"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/markdown-0.29.0.wasm"
  ]
}
