{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9999,
  "env": {
    "CLAUDE_CODE_CERT_STORE": "bundled",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "ENABLE_TOOL_SEARCH": "true",
    "GIT_CONFIG_COUNT": "3",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false",
    "GIT_CONFIG_KEY_1": "commit.gpgsign",
    "GIT_CONFIG_VALUE_1": "false",
    "GIT_CONFIG_KEY_2": "tag.gpgsign",
    "GIT_CONFIG_VALUE_2": "false"
  },
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "deny": [
      "Read(~/.codex/auth.json)"
    ]
  },
  "model": "opus",
  "preferredNotifChannel": "auto",
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/statusline/statusline.py\""
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "enabled": true,
    "enableWeakerNetworkIsolation": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/nix",
        "~/.cache/uv",
        "~/Library/Caches/dprint",
        "~/.cache/dprint",
        "~/.local/state/agent-harness",
        "~/.local/share/pnpm",
        "~/go/pkg/mod",
        "~/go/pkg/sumdb",
        "~/Library/Caches/go-build",
        "~/Library/Caches/golangci-lint",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/.package-cache",
        "~/.cargo/.package-cache-mutate",
        "~/.cargo/.global-cache",
        "~/.cargo/.global-cache-journal"
      ],
      "denyRead": [
        "~/.codex/auth.json",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/**"
      ],
      "denyWrite": [
        "~/.local/state/agent-harness/verification",
        "~/.local/state/agent-harness/model-rules",
        "~/.local/state/agent-harness/trusted-owners",
        "~/.local/state/agent-harness/audit",
        "~/**/.git/hooks",
        "~/**/.git/config",
        "~/**/.git/worktrees/*/config.worktree"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.osv.dev",
        "channels.nixos.org",
        "files.pythonhosted.org",
        "index.crates.io",
        "plugins.dprint.dev",
        "proxy.golang.org",
        "pypi.org",
        "registry.npmjs.org",
        "static.crates.io",
        "sum.golang.org",
        "vuln.go.dev"
      ],
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "~/.claude/hooks/cleanup_worktrees.py",
      "~/.claude/hooks/cleanup_worktrees.py --dry-run",
      "agent-browser *",
      "agent-desktop *",
      "docker *",
      "gh *",
      "herdr *",
      "node \"~/.claude/plugins/cache/openai-codex/codex/*/scripts/codex-companion.mjs\" *",
      "watchman *"
    ]
  },
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "skipAutoPermissionPrompt": true,
  "editorMode": "normal"
}
