{
  "bats": {
    "source_extensions": [".sh", ".bats"],
    "test_dirs": ["tests"],
    "test_patterns": ["{stem}.bats", "test_{stem}.bats"],
    "self_test_extensions": [".bats"],
    "fallback_on_unmatched_source": true
  },
  "python": {
    "source_extensions": [".py"],
    "test_dirs": ["."],
    "test_patterns": ["test_{stem}.py", "{stem}_test.py"],
    "self_test_globs": ["test_*.py", "*_test.py"],
    "exclude_dirs": [
      ".venv",
      "node_modules",
      ".cache",
      "build",
      "dist",
      "target",
      ".tox",
      "__pycache__",
      ".pytest_cache",
      ".ruff_cache",
      ".mypy_cache"
    ],
    "project_markers": ["pyproject.toml"],
    "full_suite_triggers": [
      "conftest.py",
      "**/conftest.py",
      "pyproject.toml",
      "**/pyproject.toml",
      "pytest.ini",
      "**/pytest.ini",
      "uv.lock",
      "**/uv.lock"
    ],
    "fallback_on_unmatched_source": true
  },
  "javascript_typescript": {
    "source_extensions": [".js", ".jsx", ".ts", ".tsx", ".mts", ".cts", ".mjs", ".cjs"],
    "project_markers": ["package.json", "pnpm-lock.yaml", "tsconfig.json"],
    "test_dirs": ["."],
    "exclude_dirs": ["node_modules", ".venv", "dist", "build", "coverage", "__pycache__"],
    "test_patterns": [
      "{stem}.test.js",
      "{stem}.spec.js",
      "{stem}.test.jsx",
      "{stem}.spec.jsx",
      "{stem}.test.ts",
      "{stem}.spec.ts",
      "{stem}.test.tsx",
      "{stem}.spec.tsx",
      "{stem}.test.mts",
      "{stem}.spec.mts",
      "{stem}.test.cts",
      "{stem}.spec.cts",
      "{stem}.test.mjs",
      "{stem}.spec.mjs",
      "{stem}.test.cjs",
      "{stem}.spec.cjs"
    ],
    "self_test_globs": [
      "*.test.js",
      "*.spec.js",
      "*.test.jsx",
      "*.spec.jsx",
      "*.test.ts",
      "*.spec.ts",
      "*.test.tsx",
      "*.spec.tsx",
      "*.test.mts",
      "*.spec.mts",
      "*.test.cts",
      "*.spec.cts",
      "*.test.mjs",
      "*.spec.mjs",
      "*.test.cjs",
      "*.spec.cjs"
    ],
    "full_suite_triggers": [
      "package.json",
      "**/package.json",
      "package-lock.json",
      "**/package-lock.json",
      "pnpm-lock.yaml",
      "**/pnpm-lock.yaml",
      "yarn.lock",
      "**/yarn.lock",
      "bun.lock",
      "**/bun.lock",
      "bun.lockb",
      "**/bun.lockb",
      "tsconfig.json",
      "**/tsconfig.json",
      "tsconfig.*.json",
      "**/tsconfig.*.json",
      "jest.config.*",
      "**/jest.config.*",
      "vitest.config.*",
      "**/vitest.config.*",
      "vitest.workspace.*",
      "**/vitest.workspace.*"
    ],
    "fallback_on_unmatched_source": true
  },
  "rust": {
    "source_extensions": [".rs"],
    "project_markers": ["Cargo.toml"],
    "integration_test_dir": "tests",
    "source_dirs": ["src"],
    "full_suite_triggers": [
      "Cargo.toml",
      "**/Cargo.toml",
      "Cargo.lock",
      "**/Cargo.lock",
      "rust-toolchain",
      "**/rust-toolchain",
      "rust-toolchain.toml",
      "**/rust-toolchain.toml"
    ],
    "fallback_on_unmatched_source": true
  },
  "go": {
    "source_extensions": [".go"],
    "project_markers": ["go.mod"],
    "exclude_dirs": ["vendor"],
    "full_suite_triggers": [
      "go.mod",
      "**/go.mod",
      "go.sum",
      "**/go.sum",
      "go.work",
      "**/go.work",
      "go.work.sum",
      "**/go.work.sum"
    ],
    "fallback_on_unmatched_source": true
  }
}
